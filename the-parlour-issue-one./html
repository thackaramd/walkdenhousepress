<title>The Parlour — Issue One</title>

<style>

:root {
    --bg: #f2e9df;
    --text: #241a18;
    --text-soft: rgba(36,26,24,0.72);
    --accent: #7a564a;
    --line: rgba(36,26,24,0.055);
}

* {
    box-sizing: border-box;
}

html,
body {
    min-height:100%;
    margin:0;
}

body {

    background:var(--bg);
    color:var(--text);

    font-family:
    "Baskerville",
    "Times New Roman",
    serif;

    display:flex;
    flex-direction:column;

    -webkit-font-smoothing:antialiased;
}


/* paper texture */

body::before {

    content:"";

    position:fixed;
    inset:0;

    pointer-events:none;

    opacity:0.016;

    background-image:
    url("https://www.transparenttextures.com/patterns/asfalt-light.png");
}


/* header */

.header {

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:34px 64px 26px;

}


.title-wrapper {

    display:flex;
    align-items:flex-start;

    gap:12px;

    color:inherit;
    text-decoration:none;
}


.title-wrapper img {

    height:2.7rem;

}


.title-group {

    display:flex;
    flex-direction:column;

}


.title {

    font-size:1.72rem;

}


.subtitle {

    margin-top:2px;

    font-size:0.66rem;

    letter-spacing:1px;

    text-transform:uppercase;

    color:var(--text-soft);

}


.nav {

    display:flex;

    gap:32px;

}


.nav a {

    color:var(--text-soft);

    text-decoration:none;

}


.nav a:hover {

    color:var(--text);

}



.line {

    height:1px;

    width:calc(100% - 120px);

    margin:auto;

    background:
    linear-gradient(
    to right,
    transparent,
    var(--line),
    transparent
    );

}



/* main */

main {

    flex:1;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:100px 24px;

}


.issue {

    text-align:center;

    max-width:600px;

}


.kicker {

    font-size:0.72rem;

    letter-spacing:2.2px;

    text-transform:uppercase;

    color:var(--text-soft);

    margin-bottom:28px;

}



h1 {

    font-size:2.6rem;

    font-weight:normal;

    margin:0 0 18px;

}



.issue p {

    font-size:1.15rem;

    line-height:1.8;

    color:var(--text-soft);

}



.button {

    display:inline-block;

    margin-top:45px;

    padding:14px 32px;

    border:1px solid rgba(36,26,24,0.25);

    color:var(--text);

    text-decoration:none;

    transition:0.3s ease;

}


.button:hover {

    background:rgba(36,26,24,0.05);

}



@media(max-width:760px){

.header {

padding:24px;

}

.nav {

display:none;

}


main {

padding:70px 20px;

}


h1 {

font-size:2rem;

}

}

</style>

</head>


<body>


